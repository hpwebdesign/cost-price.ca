{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-cp-merchant" data-toggle="tooltip" title="{{ button_save|default('Save') }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel|default('Cancel') }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <p class="text-muted">
          This module powers the Cost-Price merchant application: the storefront page at
          <code>account/merchant</code>, the "Merchant Application" tab on the Customer edit
          screen, and the Merchant Status column on the Customer list. There are no per-page
          settings to configure &mdash; just keep this enabled.
        </p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-cp-merchant" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">Status</label>
            <div class="col-sm-10">
              <select name="module_cp_merchant_status" id="input-status" class="form-control">
                {% if module_cp_merchant_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">Merchant Customer Groups</label>
            <div class="col-sm-10">
              <div class="well" style="max-height: 220px; overflow-y: auto;">
                {% for customer_group in customer_groups %}
                <div class="checkbox">
                  <label>
                    <input type="checkbox" name="module_cp_merchant_group_ids[]" value="{{ customer_group.customer_group_id }}" {% if customer_group.customer_group_id in module_cp_merchant_group_ids %}checked="checked"{% endif %} />
                    {{ customer_group.name }}
                  </label>
                </div>
                {% endfor %}
              </div>
              <p class="text-muted">Customers in any of the checked groups are treated as merchants: they get redirected to the merchant application after login, and see the "Merchant Application" tab on their Customer edit screen.</p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
