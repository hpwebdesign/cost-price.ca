{{ header }}
<link rel="stylesheet" type="text/css" href="catalog/view/javascript/merchant.css" />
<div class="container cp-merchant-container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {% if error.warning is defined %}
  <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error.warning }}</div>
  {% endif %}

  <div class="row">
    {{ column_left }}
    <div id="content" class="{% if column_left and column_right %}col-sm-6{% elseif column_left or column_right %}col-sm-9{% else %}col-sm-12{% endif %}">
      {{ content_top }}

      <div class="cp-merchant-app">

        <div class="cp-masthead">
          <h1>{{ heading_title }}</h1>
          <p class="cp-masthead-sub">A few details so we can set up your wholesale account.</p>
        </div>

        <div class="cp-layout">
          <nav class="cp-tabs" id="cpTabs">
            <div class="cp-tab active" data-step="0"><span class="cp-tab-num">1</span><span class="cp-tab-label">{{ text_step_contact }}</span><span class="cp-tab-stamp">&#10003;</span></div>
            <div class="cp-tab" data-step="1"><span class="cp-tab-num">2</span><span class="cp-tab-label">{{ text_step_billing }}</span><span class="cp-tab-stamp">&#10003;</span></div>
            <div class="cp-tab" data-step="2"><span class="cp-tab-num">3</span><span class="cp-tab-label">{{ text_step_shipping }}</span><span class="cp-tab-stamp">&#10003;</span></div>
            <div class="cp-tab" data-step="3"><span class="cp-tab-num">4</span><span class="cp-tab-label">{{ text_step_business }}</span><span class="cp-tab-stamp">&#10003;</span></div>
            <div class="cp-tab" data-step="4"><span class="cp-tab-num">5</span><span class="cp-tab-label">{{ text_step_category }}</span><span class="cp-tab-stamp">&#10003;</span></div>
            <div class="cp-tab" data-step="5"><span class="cp-tab-num">6</span><span class="cp-tab-label">{{ text_step_review }}</span><span class="cp-tab-stamp">&#10003;</span></div>
          </nav>

          <div class="cp-panel">
            <form id="cpMerchantForm" action="{{ action }}" method="post">

              <div class="cp-step active" data-step="0">
                <h2>{{ text_step_contact }}</h2>
                <div class="cp-grid">
                  <div class="cp-field full">
                    <label>Business Operating Name <span class="req">*</span></label>
                    <input type="text" name="business_operating_name" value="{{ business_operating_name }}" required>
                    {% if error.business_operating_name is defined %}<span class="cp-error">{{ error.business_operating_name }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Manager First Name <span class="req">*</span></label>
                    <input type="text" name="manager_first_name" value="{{ manager_first_name }}" required>
                    {% if error.manager_first_name is defined %}<span class="cp-error">{{ error.manager_first_name }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Manager Last Name <span class="req">*</span></label>
                    <input type="text" name="manager_last_name" value="{{ manager_last_name }}" required>
                    {% if error.manager_last_name is defined %}<span class="cp-error">{{ error.manager_last_name }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Title / Position <span class="req">*</span></label>
                    <input type="text" name="title_position" value="{{ title_position }}" required>
                    {% if error.title_position is defined %}<span class="cp-error">{{ error.title_position }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Phone <span class="req">*</span></label>
                    <input type="text" name="phone" value="{{ phone }}" required>
                    {% if error.phone is defined %}<span class="cp-error">{{ error.phone }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Cell</label>
                    <input type="text" name="cell" value="{{ cell }}">
                  </div>
                  <div class="cp-field">
                    <label>Email</label>
                    <input type="text" value="{{ customer_email }}" disabled>
                  </div>
                  <div class="cp-field full">
                    <label>Mailing Address for Promotions and Special Deals <span class="req">*</span></label>
                    <textarea name="promo_mailing_address" required>{{ promo_mailing_address }}</textarea>
                    {% if error.promo_mailing_address is defined %}<span class="cp-error">{{ error.promo_mailing_address }}</span>{% endif %}
                  </div>
                </div>
              </div>

              <div class="cp-step" data-step="1">
                <h2>{{ text_step_billing }}</h2>
                <div class="cp-grid">
                  <div class="cp-field full">
                    <label>Address 1 <span class="req">*</span></label>
                    <input type="text" name="billing_address_1" id="billing_address_1" value="{{ billing_address_1 }}" required>
                    {% if error.billing_address_1 is defined %}<span class="cp-error">{{ error.billing_address_1 }}</span>{% endif %}
                  </div>
                  <div class="cp-field full">
                    <label>Address 2</label>
                    <input type="text" name="billing_address_2" id="billing_address_2" value="{{ billing_address_2 }}">
                  </div>
                  <div class="cp-field">
                    <label>City <span class="req">*</span></label>
                    <input type="text" name="billing_city" id="billing_city" value="{{ billing_city }}" required>
                    {% if error.billing_city is defined %}<span class="cp-error">{{ error.billing_city }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Province <span class="req">*</span></label>
                    <input type="text" name="billing_province" id="billing_province" value="{{ billing_province }}" required>
                    {% if error.billing_province is defined %}<span class="cp-error">{{ error.billing_province }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Postal Code <span class="req">*</span></label>
                    <input type="text" name="billing_postcode" id="billing_postcode" value="{{ billing_postcode }}" required>
                    {% if error.billing_postcode is defined %}<span class="cp-error">{{ error.billing_postcode }}</span>{% endif %}
                  </div>
                </div>
              </div>

              <div class="cp-step" data-step="2">
                <h2>{{ text_step_shipping }}</h2>
                <label class="cp-check-row" for="shipping_same_as_billing">
                  <input type="checkbox" name="shipping_same_as_billing" id="shipping_same_as_billing" value="1" {% if shipping_same_as_billing %}checked{% endif %}>
                  <span>Same as Billing Information</span>
                </label>
                <div class="cp-grid" id="cpShippingFields">
                  <div class="cp-field full">
                    <label>Address 1 <span class="req">*</span></label>
                    <input type="text" name="shipping_address_1" id="shipping_address_1" value="{{ shipping_address_1 }}" required>
                    {% if error.shipping_address_1 is defined %}<span class="cp-error">{{ error.shipping_address_1 }}</span>{% endif %}
                  </div>
                  <div class="cp-field full">
                    <label>Address 2</label>
                    <input type="text" name="shipping_address_2" id="shipping_address_2" value="{{ shipping_address_2 }}">
                  </div>
                  <div class="cp-field">
                    <label>City <span class="req">*</span></label>
                    <input type="text" name="shipping_city" id="shipping_city" value="{{ shipping_city }}" required>
                    {% if error.shipping_city is defined %}<span class="cp-error">{{ error.shipping_city }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Province <span class="req">*</span></label>
                    <input type="text" name="shipping_province" id="shipping_province" value="{{ shipping_province }}" required>
                    {% if error.shipping_province is defined %}<span class="cp-error">{{ error.shipping_province }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Postal Code <span class="req">*</span></label>
                    <input type="text" name="shipping_postcode" id="shipping_postcode" value="{{ shipping_postcode }}" required>
                    {% if error.shipping_postcode is defined %}<span class="cp-error">{{ error.shipping_postcode }}</span>{% endif %}
                  </div>
                </div>
              </div>

              <div class="cp-step" data-step="3">
                <h2>{{ text_step_business }}</h2>
                <p class="cp-subhead">Type of Business <span class="req">*</span></p>
                <div class="cp-radio-grid">
                  {% for value, label in business_types %}
                  <label class="cp-opt{% if business_type == value %} checked{% endif %}">
                    <input type="radio" name="business_type" value="{{ value }}" {% if business_type == value %}checked{% endif %} required> {{ label }}
                  </label>
                  {% endfor %}
                </div>
                {% if error.business_type is defined %}<span class="cp-error">{{ error.business_type }}</span>{% endif %}

                <div class="cp-grid" style="margin-top:20px;">
                  <div class="cp-field full">
                    <label>Legal Business Name <span class="req">*</span></label>
                    <input type="text" name="legal_business_name" value="{{ legal_business_name }}" required>
                    {% if error.legal_business_name is defined %}<span class="cp-error">{{ error.legal_business_name }}</span>{% endif %}
                  </div>
                  <div class="cp-field full">
                    <label>Name of Legal Business Owner <span class="req">*</span></label>
                    <input type="text" name="legal_business_owner" value="{{ legal_business_owner }}" required>
                    {% if error.legal_business_owner is defined %}<span class="cp-error">{{ error.legal_business_owner }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Federal Business (GST/HST) Number <span class="req">*</span></label>
                    <input type="text" name="gst_hst_number" value="{{ gst_hst_number }}" required>
                    {% if error.gst_hst_number is defined %}<span class="cp-error">{{ error.gst_hst_number }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Year and Month Business Started <span class="req">*</span></label>
                    <input type="text" name="business_started" placeholder="e.g. 2019-06" value="{{ business_started }}" required>
                    {% if error.business_started is defined %}<span class="cp-error">{{ error.business_started }}</span>{% endif %}
                  </div>
                </div>
              </div>

              <div class="cp-step" data-step="4">
                <h2>{{ text_step_category }}</h2>
                <div class="cp-checkbox-grid">
                  {% for value, label in categories %}
                  <label class="cp-opt{% if value in categories_selected %} checked{% endif %}">
                    <input type="checkbox" name="categories[]" value="{{ value }}" {% if value in categories_selected %}checked{% endif %}> {{ label }}
                  </label>
                  {% endfor %}
                </div>
                <div class="cp-field full" style="margin-top:16px;">
                  <label>Other</label>
                  <input type="text" name="category_other" value="{{ category_other }}" placeholder="Tell us what else you're looking for">
                </div>
              </div>

              <div class="cp-step" data-step="5">
                <h2>{{ text_step_review }}</h2>
                <div class="cp-field full" style="margin-bottom:20px;">
                  <label>Questions / Comments</label>
                  <textarea name="questions_comments" style="min-height:100px;">{{ questions_comments }}</textarea>
                </div>

                <hr class="cp-divider">

                <div class="cp-confirm-box">
                  By submitting this form, the applicant confirms that all information provided is true and complete.
                </div>

                <div class="cp-grid">
                  <div class="cp-field">
                    <label>Applicant Name <span class="req">*</span></label>
                    <input type="text" name="applicant_name" value="{{ applicant_name }}" required>
                    {% if error.applicant_name is defined %}<span class="cp-error">{{ error.applicant_name }}</span>{% endif %}
                  </div>
                  <div class="cp-field">
                    <label>Date Submitted</label>
                    <input type="text" value="Auto-filled on submit" disabled>
                  </div>
                </div>

                <div class="cp-notice">
                  <strong>Cost-Price will review all applications</strong> and contact approved applicants within 24&ndash;48 business hours. Please do not submit payment information through this application form.
                </div>
              </div>

              <div class="cp-step-footer">
                <span class="cp-progress-text" id="cpProgressText">STEP 1 / 6</span>
                <div class="cp-nav-group">
                  <button type="button" class="btn cp-btn-back" id="cpBtnBack">Back</button>
                  <button type="button" class="btn cp-btn-next" id="cpBtnNext">Continue</button>
                  <button type="submit" class="btn cp-btn-submit" id="cpBtnSubmit" style="display:none;">Submit Application</button>
                  <button type="button" class="btn cp-btn-submit" id="cpBtnSave" data-save-url="{{ ajax_save }}" style="display:none;">Save</button>
                </div>
              </div>

            </form>

            <div class="cp-merchant-toast" id="cpMerchantToast"></div>
          </div>
        </div>
      </div>

      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

<script type="text/javascript">
$(function(){
  var totalSteps = 6;
  var current = 0;
  var previouslySubmitted = {{ previously_submitted ? 'true' : 'false' }};

  function showToast(message, type){
    var $toast = $('#cpMerchantToast');
    $toast.removeClass('cp-toast-success cp-toast-error').addClass(type === 'error' ? 'cp-toast-error' : 'cp-toast-success');
    $toast.text(message).addClass('show');
    clearTimeout($toast.data('cpTimer'));
    var t = setTimeout(function(){ $toast.removeClass('show'); }, 2500);
    $toast.data('cpTimer', t);
  }

  function renderStep(){
    $('.cp-step').removeClass('active');
    $('.cp-step[data-step="'+current+'"]').addClass('active');

    $('.cp-tab').removeClass('active');
    $('.cp-tab[data-step="'+current+'"]').addClass('active');
    $('.cp-tab').each(function(){
      var s = parseInt($(this).data('step'));
      // Only mark a step "done" once there's an actual saved row for this
      // application (previouslySubmitted) — merely clicking past a step
      // in a brand-new registration never persisted anything, so it must
      // not show a checkmark implying the data is safely stored.
      $(this).toggleClass('done', previouslySubmitted && s < current);
    });

    $('#cpProgressText').text('STEP ' + (current + 1) + ' / ' + totalSteps);

    if (previouslySubmitted) {
      // Returning merchants edit freely — every section just has Save,
      // no linear Continue/Submit gate.
      $('#cpBtnBack').toggle(current > 0);
      $('#cpBtnNext').hide();
      $('#cpBtnSubmit').hide();
      $('#cpBtnSave').show();
    } else {
      $('#cpBtnBack').toggle(current > 0);
      $('#cpBtnNext').toggle(current < totalSteps - 1);
      $('#cpBtnSubmit').toggle(current === totalSteps - 1);
      $('#cpBtnSave').hide();
    }
  }

  // Tabs are freely clickable — merchants revisiting a submitted
  // application (or fixing a validation error) shouldn't have to walk
  // through Continue/Back one step at a time to reach a section.
  $('#cpTabs').on('click', '.cp-tab', function(){
    current = parseInt($(this).data('step'));
    renderStep();
  });

  $('#cpBtnNext').on('click', function(){
    var $active = $('.cp-step.active');
    var valid = true;

    $active.find('input[required], textarea[required]').each(function(){
      if (!this.checkValidity()) {
        this.reportValidity();
        valid = false;
        return false;
      }
    });

    if (!valid) return;
    if (current < totalSteps - 1){ current++; renderStep(); }
  });

  $('#cpBtnBack').on('click', function(){
    if (current > 0){ current--; renderStep(); }
  });

  // AJAX save, used only once the merchant already has data on file —
  // saves the whole form as-is and shows a toast instead of reloading
  // the page, so they stay on whichever section they're editing.
  $('#cpBtnSave').on('click', function(){
    var $btn = $(this);
    var url = $btn.data('save-url');

    $btn.prop('disabled', true);

    $.ajax({
      url: url,
      type: 'post',
      data: $('#cpMerchantForm').serialize(),
      dataType: 'json',
      success: function(json){
        if (json['error']) {
          showToast(json['error'], 'error');
        } else {
          showToast(json['success'] || 'Saved!', 'success');
        }
      },
      error: function(){
        showToast('Something went wrong saving your application.', 'error');
      },
      complete: function(){
        $btn.prop('disabled', false);
      }
    });
  });

  // "Same as Billing Information" — plain jQuery DOM/event handling only,
  // no dependency on any UI component plugin
  function applySameAsBilling(){
    var checked = $('#shipping_same_as_billing').is(':checked');
    $('#cpShippingFields input').prop('disabled', checked);
    $('#cpShippingFields').css('opacity', checked ? 0.5 : 1);
    if (checked){
      $('#shipping_address_1').val($('#billing_address_1').val());
      $('#shipping_address_2').val($('#billing_address_2').val());
      $('#shipping_city').val($('#billing_city').val());
      $('#shipping_province').val($('#billing_province').val());
      $('#shipping_postcode').val($('#billing_postcode').val());
    }
  }
  $('#shipping_same_as_billing').on('change', applySameAsBilling);
  applySameAsBilling();

  $('.cp-opt input').on('change', function(){
    $(this).closest('.cp-opt').toggleClass('checked', $(this).is(':checked'));
  });

  renderStep();
});
</script>

{{ footer }}
